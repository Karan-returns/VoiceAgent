{
  "name": "intellify-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "NovaTel billing voice agent with self-healing prompt loops (LiveKit + MERN).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:agent": "tsx watch apps/agent/index.ts",
    "dev:server": "tsx watch apps/server/index.ts",
    "agent": "tsx apps/agent/index.ts",
    "server": "tsx apps/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.4.5",
    "@livekit/agents-plugin-deepgram": "^1.4.5",
    "@livekit/agents-plugin-elevenlabs": "^1.4.5",
    "@livekit/agents-plugin-google": "^1.4.5",
    "@livekit/agents-plugin-openai": "^1.4.5",
    "@livekit/agents-plugin-silero": "^1.4.5",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
